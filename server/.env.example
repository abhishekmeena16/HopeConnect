# HopeConnect Server Environment Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (NeonDB / Local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/hopeconnect?sslmode=prefer"

# JWT Authentication Secret
JWT_SECRET="your_jwt_secret_key_here"

# Cloudinary (Media Storage for Resource Donations)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Razorpay (Emergency Relief Monetary Donations)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
